<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Dashboard - FTI HC</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/basecoat-css@0.2.2/dist/basecoat.min.css"/>
  <style>
    body { background: #f5f5f5; font-family: sans-serif; margin: 0; }
    .navbar { background: #111; color: white; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; }
    .navbar h1 { font-size: 1.1rem; font-weight: 700; margin: 0; }
    .navbar span { font-size: 0.85rem; color: #aaa; }
    .btn-logout { background: transparent; border: 1px solid #555; color: white; padding: 0.3rem 0.8rem; border-radius: 5px; cursor: pointer; font-size: 0.85rem; }
    .btn-logout:hover { background: #333; }
    .container { max-width: 700px; margin: 2rem auto; padding: 0 1rem; }
    .card { background: white; border-radius: 8px; box-shadow: 0 1px 8px rgba(0,0,0,0.08); padding: 1.5rem; }
    .card h2 { margin: 0 0 0.5rem; font-size: 1.1rem; }
    .card p { color: #666; font-size: 0.9rem; margin: 0; }
    .badge { display: inline-block; background: #f0f0f0; color: #333; padding: 0.2rem 0.7rem; border-radius: 99px; font-size: 0.78rem; font-weight: 600; margin-top: 0.75rem; }
  </style>
</head>
<body>
  <nav class="navbar">
    <h1>FTI HC - Sistem Kepegawaian</h1>
    <div style="display:flex;align-items:center;gap:1rem;">
      <span><%= user.name %></span>
      <button class="btn-logout" onclick="logout()">Keluar</button>
    </div>
  </nav>

  <div class="container">
    <div class="card">
      <h2>Selamat datang, <%= user.name %>!</h2>
      <p>Kamu berhasil login ke sistem FTI HC.</p>
      <div>
        <% user.roles.forEach(function(r) { %>
          <span class="badge"><%= r %></span>
        <% }); %>
      </div>
    </div>
  </div>

  <script>
    async function logout() {
      await fetch('/auth/logout', { method: 'POST' });
      window.location.href = '/auth/login';
    }
  </script>
</body>
</html>