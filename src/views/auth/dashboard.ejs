<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Dashboard - FTI HC</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/basecoat-css@0.2.2/dist/basecoat.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
  <nav class="navbar">
    <h1 class="navbar__brand">FTI HC - Sistem Kepegawaian</h1>
    <div class="navbar__right">
      <span class="navbar__username"><%= user.name %></span>
      <button class="btn-logout" onclick="logout()">Keluar</button>
    </div>
  </nav>

  <div class="container">
    <div class="card">
      <h2 class="card__title">Selamat datang, <%= user.name %>!</h2>
      <p class="card__desc">Kamu berhasil login ke sistem FTI HC.</p>
      <div>
        <% user.roles.forEach(function(r) { %>
          <span class="badge"><%= r %></span>
        <% }); %>
      </div>
    </div>
  </div>

  <script>
    async function logout() {
      await fetch('/auth/logout', { method: 'POST' });
      window.location.href = '/auth/login';
    }
  </script>
</body>
</html>
